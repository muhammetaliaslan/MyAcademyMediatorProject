@using MyAcademyMediatorProject.Models
@model HomeIndexViewModel

@{
    Layout = "~/Areas/User/Views/Shared/_Layout.cshtml";
}

<!-- banner-section -->
<section class="banner-section style-one" id="slider">
    <div class="banner-carousel owl-theme owl-carousel owl-dots-none nav-style-one">

        @if (Model.Sliders != null && Model.Sliders.Any())
        {
            foreach (var slide in Model.Sliders)
            {
                <div class="slide-item">
                    <div class="auto-container">
                        <div class="content-inner">

                            <!-- Sol taraf: yazılar -->
                            <div class="content-box">
                                <h1>@slide.Title</h1>
                                <p>@slide.Subtitle</p>
                                <div class="btn-box">
                                    <a href="#" class="banner-btn">Keşfet</a>
                                </div>
                            </div>

                            <!-- Sağ taraf: DB'den gelen küçük görsel -->
                            <figure class="image-box style-one">
                                <img src="@Url.Content(slide.ImageUrl)" alt="@slide.Title" class="banner-img">
                            </figure>

                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <!-- Statik fallback -->
            <div class="slide-item">
                <div class="auto-container">
                    <div class="content-inner">

                        <div class="content-box">
                            <h1>Lezzetin En Güzel Hali</h1>
                            <p>Günlük taze ürünlerimizle tanışın</p>
                            <div class="btn-box">
                                <a href="#" class="banner-btn">Keşfet</a>
                            </div>
                        </div>

                        <figure class="image-box style-one">
                            <img src="~/assets/images/banner/banner-1.jpg" alt="Banner" class="banner-img">
                        </figure>

                    </div>
                </div>
            </div>
        }

    </div>
</section>
<!-- banner-section end -->
<!-- shop-section -->
<section class="shop-section sec-pad" id="shop">
    <div class="auto-container">

        <div class="sec-title centred">
            <p>Mağaza</p>
            <h2>Ürünlerimiz</h2>
        </div>

        <div class="row clearfix">

            @if (Model.Products != null && Model.Products.Any())
            {
                foreach (var product in Model.Products)
                {
                    <div class="col-lg-3 col-md-6 col-sm-12 shop-block">
                        <div class="shop-block-one wow fadeInUp animated">
                            <div class="inner-box">

                                <figure class="image-box">
                                    <img src="@Url.Content(product.ImageUrl)" alt="@product.Name" />
                                </figure>

                                <div class="lower-content">
                                    <h3>@product.Name</h3>
                                    <span class="price">@product.Price.ToString("C")</span>
                                    <div class="cart-btn">
                                        <a href="#" class="theme-btn-two">Sepete Ekle</a>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <p class="text-center">Henüz ürün eklenmemiş.</p>
            }

        </div>

    </div>
</section>
<!-- shop-section end -->
<!-- Custom Banner CSS -->
<link rel="stylesheet" href="~/custom-banner.css/custom-banner.css" />

<!-- Owl Carousel JS -->
<link rel="stylesheet" href="~/Bagery/assets/css/owl.carousel.min.css" />
<link rel="stylesheet" href="~/Bagery/assets/css/owl.theme.default.min.css" />
<script src="~/Bagery/assets/js/jquery.js"></script>
<script src="~/Bagery/assets/js/owl.carousel.min.js"></script>
<script>
    $(document).ready(function(){
        $(".banner-carousel").owlCarousel({
            items:1,
            loop:true,
            nav:true,
            dots:true,
            autoplay:true,
            autoplayTimeout:5000,
            smartSpeed:800,
            navText:["<i class='bi bi-chevron-left'></i>","<i class='bi bi-chevron-right'></i>"]
        });
    });
</script>