<!-- main header -->
<header class="main-header style-one" data-sync="true">

    <!-- header-lower -->
    <div class="header-lower" data-sync="true">
        <div class="outer-box">
            <div class="logo-box">
                <figure class="logo"><a href="index.html"><img src="/Bagery/assets/images/logo.png" alt=""></a></figure>
            </div>

            <div class="menu-area">
                <div class="mobile-nav-toggler">
                    <i class="icon-bar"></i>
                    <i class="icon-bar"></i>
                    <i class="icon-bar"></i>
                </div>

                <nav class="main-menu navbar-expand-md navbar-light">
                    <div class="collapse navbar-collapse show clearfix" id="navbarSupportedContent">
                        <ul class="navigation scroll-nav clearfix">
                            <li class="current dropdown">
                                <a href="index.html">Home</a>
                                <ul>
                                    <li><a href="index.html">Ice Cream Shop</a></li>
                                    <li><a href="index-2.html">Cake Shop</a></li>
                                    <li><a href="index-3.html">Coffe Shop</a></li>
                                    <li><a href="index-4.html">Bread Shop</a></li>
                                    <li><a href="index-onepage.html">OnePage Home</a></li>
                                    <li><a href="index-rtl.html">RTL Home</a></li>
                                </ul>
                            </li>
                            <li><a href="#about">About</a></li>
                            <li><a href="#shop">Shop</a></li>
                            <li><a href="#service">Services</a></li>
                            <li><a href="#gallery">Gallery</a></li>
                            <li><a href="#news">News</a></li>
                        </ul>
                    </div>
                </nav>
            </div>

        </div>
    </div>

    <!-- sticky header -->
    <div class="sticky-header" data-sync="true">
        <div class="outer-box">
            <div class="logo-box">
                <figure class="logo"><a href="index.html"><img src="assets/images/small-logo.png" alt=""></a></figure>
            </div>
        </div>
    </div>

</header>
<!-- main-header end -->
<!-- banner-section -->

<section class="banner-section style-one" id="slider">
    <div class="banner-carousel owl-theme owl-carousel owl-dots-none nav-style-one">

        @if (Model.Sliders != null && Model.Sliders.Any())
        {
            foreach (var slide in Model.Sliders)
            {
                <div class="slide-item" data-bg="@slide.BgColor"
                            data-index="@Model.Sliders.ToList().IndexOf(slide)">
                    <div class="auto-container">
                        <div class="content-inner">

                            <!-- Sol taraf: yazılar -->
                            <div class="content-box">
                                <h1>@slide.Title</h1>
                                <p>@slide.Subtitle</p>
                                <div class="btn-box">
                                    <a href="#" class="banner-btn">Keşfet</a>
                                </div>
                            </div>

                            <!-- Sağ taraf: veritabanından gelen görsel -->
                            <figure class="image-box style-one">
                                <img src="@slide.ImageUrl" alt="@slide.Title" class="banner-img" />
                            </figure>

                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <!-- Fallback Slider -->
            <div class="slide-item" data-bg="#e67e22">
                <div class="auto-container">
                    <div class="content-inner">
                        <div class="content-box">
                            <h1>Lezzetin En Güzel Hali</h1>
                            <p>Günlük taze ürünlerimizle tanışın</p>
                            <div class="btn-box">
                                <a href="#" class="banner-btn">Keşfet</a>
                            </div>
                        </div>
                        <figure class="image-box style-one">
                            <img src="https://azim.commonsupport.com/Bagery/assets/images/banner/3f5515b1-3341-4ce9-9e07-f8b8dd024f2f.png" alt="Banner" class="banner-img" />
                        </figure>
                    </div>
                </div>
            </div>
        }

    </div>
</section>
<!-- banner-section -->
<!-- Features Section -->
<section class="features-section sec-pad">
    <div class="auto-container">
        <div class="row clearfix">

            <!-- 01 - Bakery -->
            <div class="col-lg-4 col-md-6 col-sm-12 feature-block">
                <div class="feature-box">
                    <span class="feature-number">01</span>
                    <h3>Fırın Ürünleri</h3>
                    <p>Günlük taze fırın ürünlerimizle lezzeti evinize taşıyoruz.</p>
                </div>
            </div>

            <!-- 02 - Pasta -->
            <div class="col-lg-4 col-md-6 col-sm-12 feature-block">
                <div class="feature-box">
                    <span class="feature-number">02</span>
                    <h3>Pasta & Kek</h3>
                    <p>El yapımı pastalar ve kekler ile tatlı keyfinizi katlayın.</p>
                </div>
            </div>

            <!-- 03 - Şekerleme -->
            <div class="col-lg-4 col-md-6 col-sm-12 feature-block">
                <div class="feature-box">
                    <span class="feature-number">03</span>
                    <h3>Şekerleme</h3>
                    <p>Özel tariflerle hazırlanan şekerlemelerimizle tatlı anlar yaratın.</p>
                </div>
            </div>

        </div>
    </div>
</section>


<!-- Our Story Centered Section -->
<section class="our-story-centered sec-pad">
    <div class="auto-container">
        <div class="row clearfix align-items-center justify-content-center">

            <!-- Sol Yazı -->
            <div class="col-lg-3 col-md-12 col-sm-12 left-text">
                <div class="content-box">
                    <h3>Bagery Hakkında</h3>
                    <p>
                        Pastanemizde, geleneksel lezzetleri modern dokunuşlarla buluşturarak
                        sizlere her zaman taze ve kaliteli ürünler sunuyoruz. Usta ellerden çıkan pasta, börek ve tatlı çeşitlerimizle
                        gününüze tat katarken, sıcak ve samimi ortamımızda keyifli anlar yaşamanızı amaçlıyoruz.  </p>

                    
                </div>
            </div>

            <!-- Ortadaki Görsel -->
            <div class="col-lg-6 col-md-12 col-sm-12 image-column">
                <figure class="image-box">

                    <!-- ORTADAKİ YAZI (YENİ EKLENDİ) -->
                    <div class="image-overlay-text">
                        <h1>Geleneksel ve Modern Hizmet</h1>
                        <h1>1970'ten Beri</h1>
                    </div>

                    <img src="~/ice-cream-1.png" alt="Our Story" />
                </figure>
            </div>

            <!-- Sağ Yazı -->
            <div class="col-lg-3 col-md-12 col-sm-12 right-text">
                <div class="content-box">
                    <h3>Bagery Hakkında Genel Bakış</h3>
                    <p>
                        Kalite ve hijyen konusundaki hassasiyetimizle, kullandığımız tüm malzemeleri özenle seçiyor ve üretim sürecimizin her aşamasında
                        titizlikle çalışıyoruz.
                    </p>

                </div>
            </div>

        </div>
    </div>
</section>
<!-- Shop Section -->
<section class="shop-section sec-pad" id="shop">
    <div class="auto-container">

        <div class="sec-title centred">
            
            <h1>Ürünlerimiz</h1>
        </div>

        <div class="row clearfix">
            @if (Model.Products != null && Model.Products.Any())
            {
                foreach (var product in Model.Products)
                {
                    <div class="col-lg-3 col-md-6 col-sm-12 shop-block">
                        <div class="shop-block-one wow fadeInUp animated">
                            <div class="inner-box">

                                <figure class="image-box">
                                    <img src="@product.ImageUrl" alt="@product.Name" />
                                </figure>

                                <div class="lower-content">
                                    <h3>@product.Name</h3>
                                    <span class="price">@product.Price.ToString("C")</span>
                                    <div class="cart-btn">
                                        <a href="#" class="theme-btn-two">Sepete Ekle</a>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <p class="text-center">Henüz ürün eklenmemiş.</p>
            }
        </div>

    </div>
</section>

