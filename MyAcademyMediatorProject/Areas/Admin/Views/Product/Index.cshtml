@model List<MyAcademyMediatorProject.MediatorPattern.Results.ProductResult.GetProductsQueryResult>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h1>Ürünler</h1>

<table class="table table-hover">
    <thead class="table-light">
        <tr>
            <th>#</th>
            <th>Ürün Adı</th>
            <th class="text-end">Fiyat</th>
            <th class="text-end">Stok</th>
            <th>Kategori</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @{
            int count = 0;
        }
        @foreach (var item in Model)
        {
            count++;
            <tr>
                <td>@count</td>
                <td>@item.Name</td>
                <td class="text-end">@item.Price TL</td>
                <td class="text-end">@item.Stock</td>
                <td>@item.CategoryName</td>
                <td>
                    <a href="/Admin/Product/DeleteProduct/@item.Id" class="btn btn-danger btn-sm">Sil</a>
                    <a href="/Admin/Product/UpdateProduct/@item.Id" class="btn btn-info btn-sm">Güncelle</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<a href="/Admin/Product/CreateProduct" class="btn btn-dark">Yeni Ürün Oluştur</a>