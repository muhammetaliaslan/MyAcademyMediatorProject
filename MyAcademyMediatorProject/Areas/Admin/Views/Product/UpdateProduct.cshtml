@model MyAcademyMediatorProject.MediatorPattern.Results.ProductResult.GetProductByIdQueryResult

@{
    ViewData["Title"] = "Ürün Güncelle";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h1>Ürün Güncelle</h1>

<form method="post">
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label>Ürün Adı</label>
        <input type="text" asp-for="Name" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Fiyat</label>
        <input type="number" asp-for="Price" class="form-control" step="0.01" />
    </div>

    <div class="mb-3">
        <label>Stok</label>
        <input type="number" asp-for="Stock" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Kategori</label>
        <select asp-for="CategoryId" class="form-control" asp-items="@ViewBag.Categories"></select>
    </div>

    <div class="mb-3">
        <label>Ürün Görseli URL</label>
        <input type="text" asp-for="ImageUrl" class="form-control" />
        <small class="text-muted">Mevcut görsel: <img src="@Model.ImageUrl" alt="Ürün Görseli" width="100" /></small>
    </div>

    <button class="btn btn-dark">Güncelle</button>
</form>