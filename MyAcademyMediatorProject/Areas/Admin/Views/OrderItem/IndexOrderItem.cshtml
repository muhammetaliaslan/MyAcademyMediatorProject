@model List<MyAcademyMediatorProject.MediatorPattern.Results.OrderItemResults.GetOrderItemsQueryResult>

@{
    ViewData["Title"] = "Order Items";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2>Sipariş Ürünleri</h2>

<table class="table table-hover table-bordered mt-3">
    <thead class="table-dark">
        <tr>
            <th>#</th>
            <th>Sipariş</th>
            <th>Ürün</th>
            <th>Miktar</th>
            <th>Birim Fiyat</th>
            <th>Toplam Fiyat</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @{
            int count = 0;
        }
        @foreach (var item in Model)
        {
            count++;
            <tr>
                <td>@count</td>
                <td>@item.OrderCustomerName</td>
                <td>@item.ProductName</td>
                <td>@item.Quantity</td>
                <td>@item.UnitPrice.ToString("C")</td>
                <td>@(item.Quantity * item.UnitPrice).ToString("C")</td>
                <td>
                    <a href="/Admin/OrderItem/Update/@item.Id" class="btn btn-sm btn-info">Güncelle</a>
                    <a href="/Admin/OrderItem/Delete/@item.Id" class="btn btn-sm btn-danger" onclick="return confirm('Silmek istediğinize emin misiniz?');">Sil</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<a href="/Admin/OrderItem/Create" class="btn btn-dark mt-3">
    <i class="bi bi-plus-circle"></i> Yeni Sipariş Ürünü Ekle
</a>