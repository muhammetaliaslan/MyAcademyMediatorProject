@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2>Dashboard</h2>

<div class="row mt-4">
    <!-- Kategori -->
    <div class="col-md-3 mb-3">
        <div class="card text-white bg-primary shadow-sm">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h5>Kategoriler</h5>
                    <h3>@ViewBag.CategoryCount</h3>
                </div>
                <i class="bi bi-list-ul fs-1"></i>
            </div>
        </div>
    </div>

    <!-- Ürün -->
    <div class="col-md-3 mb-3">
        <div class="card text-white bg-success shadow-sm">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h5>Ürünler</h5>
                    <h3>@ViewBag.ProductCount</h3>
                </div>
                <i class="bi bi-box-seam fs-1"></i>
            </div>
        </div>
    </div>

    <!-- Sipariş -->
    <div class="col-md-3 mb-3">
        <div class="card text-white bg-warning shadow-sm">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h5>Siparişler</h5>
                    <h3>@ViewBag.OrderCount</h3>
                </div>
                <i class="bi bi-bag-check fs-1"></i>
            </div>
        </div>
    </div>

    <!-- Kullanıcı -->
    <div class="col-md-3 mb-3">
        <div class="card text-white bg-danger shadow-sm">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h5>Kullanıcılar</h5>
                    <h3>@ViewBag.UserCount</h3>
                </div>
                <i class="bi bi-people fs-1"></i>
            </div>
        </div>
    </div>
</div>

<hr />

<!-- Hızlı Erişim -->
<div class="row mt-4">
    <div class="col-md-2 mb-3">
        <a href="/Admin/Category/Index" class="btn btn-outline-primary w-100 shadow-sm">
            <i class="bi bi-list-ul"></i> Kategoriler
        </a>
    </div>
    <div class="col-md-2 mb-3">
        <a href="/Admin/Product/Index" class="btn btn-outline-success w-100 shadow-sm">
            <i class="bi bi-box-seam"></i> Ürünler
        </a>
    </div>
    <div class="col-md-2 mb-3">
        <a href="/Admin/Order/Index" class="btn btn-outline-warning w-100 shadow-sm">
            <i class="bi bi-bag-check"></i> Siparişler
        </a>
    </div>
    <div class="col-md-2 mb-3">
        <a href="/Admin/Campaign/Index" class="btn btn-outline-danger w-100 shadow-sm">
            <i class="bi bi-tags"></i> Kampanyalar
        </a>
    </div>
    <div class="col-md-2 mb-3">
        <a href="/Admin/User/Index" class="btn btn-outline-secondary w-100 shadow-sm">
            <i class="bi bi-people"></i> Kullanıcılar
        </a>
    </div>
</div>